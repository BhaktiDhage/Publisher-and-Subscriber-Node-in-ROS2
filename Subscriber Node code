#!/usr/bin/env python3

import rclpy 
from rclpy.node import Node 
from std_msgs.msg import String

class PracticeSubscriberNode(Node):

      def __init__(self):
         super().__init__("subscriber_node")
         self.subscriber_=self.create_subscription(String , "practice_topic" , self.subscriber_callback , 10)
         self.get_logger().info("Susbscriber has started")
       

      def subscriber_callback(self , msg:String):
          self.get_logger().info(msg.data)
          
          
def main(args=None):
    rclpy.init(args=args)
    node =PracticeSubscriberNode()
    rclpy.spin(node)
    rclpy.shutdown()

if __name__ == '__main__':
    main()

    
